<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gym Member Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-900 text-gray-100 font-sans pb-10">

    <header class="bg-gray-800 border-b border-gray-700 py-4 shadow-md">
        <div class="max-w-6xl mx-auto px-4 flex justify-between items-center">
            <h1 class="text-xl font-bold text-yellow-500 flex items-center gap-2">
                <i class="fa-solid font-bold fa-dumbbell"></i> Gym Dashboard
            </h1>
            <span class="text-xs bg-yellow-500/10 text-yellow-500 px-2 py-1 rounded-full border border-yellow-500/20">Live</span>
        </div>
    </header>

    <div class="max-w-6xl mx-auto px-4 mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="bg-gray-800 p-5 rounded-xl border border-gray-700 shadow-lg h-fit">
            <h2 id="formTitle" class="text-lg font-semibold mb-3 text-gray-200">नया मेंबर जोड़ें</h2>
            <form id="memberForm" class="space-y-3">
                <input type="hidden" id="memberId">
                
                <div>
                    <label class="block text-xs text-gray-400 mb-1">नाम</label>
                    <input type="text" id="name" required class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-yellow-500">
                </div>

                <div>
                    <label class="block text-xs text-gray-400 mb-1">मोबाइल नंबर (WhatsApp)</label>
                    <input type="tel" id="phone" placeholder="919876543210" required class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-yellow-500">
                </div>

                <div>
                    <label class="block text-xs text-gray-400 mb-1">जॉइनिंग डेट</label>
                    <input type="date" id="joinDate" required class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-yellow-500">
                </div>

                <div>
                    <label class="block text-xs text-gray-400 mb-1">फीस वैलिड कब तक है? (Due Date)</label>
                    <input type="date" id="validTill" required class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-yellow-500">
                </div>

                <div>
                    <label class="block text-xs text-gray-400 mb-1">फीस अमाउंट (₹)</label>
                    <input type="number" id="feeAmount" placeholder="1000" required class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-yellow-500">
                </div>

                <div class="flex gap-2 pt-2">
                    <button type="submit" id="saveBtn" class="flex-1 bg-yellow-500 hover:bg-yellow-600 text-gray-900 font-bold py-2 rounded text-sm transition">सेव करें</button>
                    <button type="button" id="cancelBtn" onclick="resetForm()" class="hidden bg-gray-600 text-white px-3 py-2 rounded text-sm">कैंसल</button>
                </div>
            </form>
        </div>

        <div class="md:col-span-2 bg-gray-800 p-5 rounded-xl border border-gray-700 shadow-lg overflow-x-auto">
            <h2 class="text-lg font-semibold mb-3 text-gray-200">मेंबर्स की लिस्ट</h2>
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-gray-700 text-gray-400 text-xs">
                        <th class="py-2 px-2">नाम & फ़ोन</th>
                        <th class="py-2 px-2">वैलिड कब तक</th>
                        <th class="py-2 px-2">स्टेटस</th>
                        <th class="py-2 px-2 text-right">एक्शन</th>
                    </tr>
                </thead>
                <tbody id="memberTableBody">
                </tbody>
            </table>
        </div>

    </div>

    <script>
        const API_URL = '/api/members';
        document.addEventListener('DOMContentLoaded', fetchMembers);

        async function fetchMembers() {
            const res = await fetch(API_URL);
            const members = await res.json();
            renderTable(members);
        }

        function renderTable(members) {
            const tbody = document.getElementById('memberTableBody');
            tbody.innerHTML = '';
            const today = new Date().toISOString().split('T')[0];

            members.forEach(m => {
                const isOverdue = m.validTill < today;
                const statusBadge = isOverdue 
                    ? `<span class="bg-red-500/20 text-red-400 border border-red-500/30 px-2 py-0.5 rounded text-[10px] font-bold">Pending</span>` 
                    : `<span class="bg-green-500/20 text-green-400 border border-green-500/30 px-2 py-0.5 rounded text-[10px] font-bold">Active</span>`;

                const message = encodeURIComponent(`नमस्ते ${m.name} जी! आपकी जिम की फीस (${m.validTill}) ओवरड्यू हो चुकी है। कृपया अपनी फीस जल्द जमा करें।`);
                const whatsappUrl = `https://wa.me/${m.phone}?text=${message}`;

                const row = document.createElement('tr');
                row.className = 'border-b border-gray-700/50 text-sm';
                row.innerHTML = `
                    <td class="py-3 px-2">
                        <div class="font-semibold text-white">${m.name}</div>
                        <div class="text-[11px] text-gray-400">${m.phone}</div>
                    </td>
                    <td class="py-3 px-2 text-xs text-gray-300">${m.validTill}</td>
                    <td class="py-3 px-2">${statusBadge}</td>
                    <td class="py-3 px-2 text-right space-x-1">
                        ${isOverdue ? `<a href="${whatsappUrl}" target="_blank" class="bg-green-600 text-white px-2 py-1 rounded text-[11px] inline-flex items-center gap-1"><i class="fa-brands fa-whatsapp"></i></a>` : ''}
                        <button onclick='editMember(${JSON.stringify(m)})' class="bg-blue-600/30 text-blue-400 px-2 py-1 rounded text-[11px]">एडिट</button>
                        <button onclick="deleteMember('${m.id}')" class="bg-red-600/30 text-red-400 px-2 py-1 rounded text-[11px]">हटाएं</button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        document.getElementById('memberForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('memberId').value;
            const data = {
                name: document.getElementById('name').value,
                phone: document.getElementById('phone').value,
                joinDate: document.getElementById('joinDate').value,
                validTill: document.getElementById('validTill').value,
                feeAmount: document.getElementById('feeAmount').value,
            };

            if (id) {
                await fetch(`${API_URL}/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
            } else {
                await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
            }

            resetForm();
            fetchMembers();
        });

        function editMember(m) {
            document.getElementById('formTitle').innerText = 'मेंबर एडिट करें';
            document.getElementById('memberId').value = m.id;
            document.getElementById('name').value = m.name;
            document.getElementById('phone').value = m.phone;
            document.getElementById('joinDate').value = m.joinDate;
            document.getElementById('validTill').value = m.validTill;
            document.getElementById('feeAmount').value = m.feeAmount;
            document.getElementById('cancelBtn').classList.remove('hidden');
        }

        function resetForm() {
            document.getElementById('formTitle').innerText = 'नया मेंबर जोड़ें';
            document.getElementById('memberId').value = '';
            document.getElementById('memberForm').reset();
            document.getElementById('cancelBtn').classList.add('hidden');
        }

        async function deleteMember(id) {
            if (confirm('क्या आप इस मेंबर को हटाना चाहते हैं?')) {
                await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
                fetchMembers();
            }
        }
    </script>
</body>
</html>
